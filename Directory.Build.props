<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Lets the net8.0-windows projects compile on macOS/Linux; they still only run on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Authors>Lucas Rocha Avelino</Authors>
    <Copyright>Copyright (c) 2026 Lucas Rocha Avelino</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/codinglucas/diskpulse</RepositoryUrl>
  </PropertyGroup>
</Project>
