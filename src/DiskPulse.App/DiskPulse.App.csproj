<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>DiskPulse.App</RootNamespace>
    <AssemblyName>DiskPulse</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Only ship framework satellite assemblies for the languages DiskPulse supports. -->
    <SatelliteResourceLanguages>en;pt-BR</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DiskPulse.Core\DiskPulse.Core.csproj" />
    <ProjectReference Include="..\DiskPulse.Windows\DiskPulse.Windows.csproj" />
  </ItemGroup>

</Project>
