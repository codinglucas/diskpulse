<Window x:Class="DiskPulse.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:DiskPulse.App.Resources"
        Title="{res:Loc Settings_Title}"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Width" Value="72" />
            <Setter Property="Margin" Value="4,3" />
            <Setter Property="Padding" Value="2,1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,3,8,3" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,16,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="4,3" />
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Width" Value="180" />
            <Setter Property="Margin" Value="4,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="14" Width="560">

        <GroupBox Header="{res:Loc Settings_General}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="{res:Loc Settings_Language}" />
                <ComboBox x:Name="LanguageBox" Grid.Column="1" />

                <TextBlock Grid.Row="1" Text="{res:Loc Settings_Hotkey}" />
                <TextBox x:Name="HotkeyBox"
                         Grid.Row="1"
                         Grid.Column="1"
                         Width="180"
                         IsReadOnly="True"
                         IsReadOnlyCaretVisible="False"
                         PreviewKeyDown="OnHotkeyKeyDown" />
                <TextBlock Grid.Row="2"
                           Grid.Column="1"
                           Margin="4,0,0,4"
                           Foreground="Gray"
                           FontSize="12"
                           Text="{res:Loc Settings_HotkeyHint}" />

                <CheckBox x:Name="StartWithWindowsBox"
                          Grid.Row="3"
                          Grid.ColumnSpan="2"
                          Content="{res:Loc Settings_StartWithWindows}" />
            </Grid>
        </GroupBox>

        <GroupBox Header="{res:Loc Settings_Overlay}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <CheckBox x:Name="ClickThroughBox" Grid.ColumnSpan="3" Content="{res:Loc Settings_ClickThrough}" />

                <TextBlock Grid.Row="1" Text="{res:Loc Settings_Opacity}" />
                <Slider x:Name="OpacitySlider" Grid.Row="1" Grid.Column="1" Minimum="20" Maximum="100" TickFrequency="5" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0:0}%}" />

                <TextBlock Grid.Row="2" Text="{res:Loc Settings_FontSize}" />
                <Slider x:Name="FontSizeSlider" Grid.Row="2" Grid.Column="1" Minimum="8" Maximum="24" TickFrequency="1" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Value, ElementName=FontSizeSlider, StringFormat={}{0:0} pt}" />

                <TextBlock Grid.Row="3" Text="{res:Loc Settings_Refresh}" />
                <ComboBox x:Name="RefreshBox" Grid.Row="3" Grid.Column="1" MinWidth="100" />

                <TextBlock Grid.Row="4" Text="{res:Loc Settings_Metrics}" VerticalAlignment="Top" />
                <WrapPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="4,0,0,0">
                    <CheckBox x:Name="ShowResponseBox" Content="{res:Loc Settings_ShowResponse}" />
                    <CheckBox x:Name="ShowActiveBox" Content="{res:Loc Settings_ShowActive}" />
                    <CheckBox x:Name="ShowQueueBox" Content="{res:Loc Settings_ShowQueue}" />
                    <CheckBox x:Name="ShowThroughputBox" Content="{res:Loc Settings_ShowThroughput}" />
                </WrapPanel>
            </Grid>
        </GroupBox>

        <GroupBox Header="{res:Loc Settings_Thresholds}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="{res:Loc Settings_SlowResponse}" TextWrapping="Wrap" />
                <TextBox x:Name="SlowMsBox" Grid.Column="1" />
                <TextBlock Grid.Column="2" Margin="8,3,0,3" Text="{res:Loc Settings_ForAtLeast}" />
                <TextBox x:Name="SlowSecondsBox" Grid.Column="3" Width="52" />

                <TextBlock Grid.Row="1" Text="{res:Loc Settings_VerySlowResponse}" TextWrapping="Wrap" />
                <TextBox x:Name="VerySlowMsBox" Grid.Row="1" Grid.Column="1" />
                <TextBlock Grid.Row="1" Grid.Column="2" Margin="8,3,0,3" Text="{res:Loc Settings_ForAtLeast}" />
                <TextBox x:Name="VerySlowSecondsBox" Grid.Row="1" Grid.Column="3" Width="52" />

                <TextBlock Grid.Row="2" Text="{res:Loc Settings_QueueLength}" TextWrapping="Wrap" />
                <TextBox x:Name="QueueBox" Grid.Row="2" Grid.Column="1" />
                <TextBlock Grid.Row="2" Grid.Column="2" Margin="8,3,0,3" Text="{res:Loc Settings_ForAtLeast}" />
                <TextBox x:Name="QueueSecondsBox" Grid.Row="2" Grid.Column="3" Width="52" />

                <TextBlock Grid.Row="3" Text="{res:Loc Settings_QueueMinResponse}" TextWrapping="Wrap" />
                <TextBox x:Name="QueueMsBox" Grid.Row="3" Grid.Column="1" />

                <TextBlock Grid.Row="4" Text="{res:Loc Settings_BusyActive}" TextWrapping="Wrap" />
                <TextBox x:Name="BusyActiveBox" Grid.Row="4" Grid.Column="1" />
                <TextBlock Grid.Row="4" Grid.Column="2" Margin="8,3,0,3" Text="{res:Loc Settings_ForAtLeast}" />
                <TextBox x:Name="BusySecondsBox" Grid.Row="4" Grid.Column="3" Width="52" />

                <TextBlock Grid.Row="5" Text="{res:Loc Settings_BusyThroughput}" TextWrapping="Wrap" />
                <TextBox x:Name="BusyMBpsBox" Grid.Row="5" Grid.Column="1" />
            </Grid>
        </GroupBox>

        <DockPanel LastChildFill="False">
            <Button DockPanel.Dock="Left" Margin="0" Content="{res:Loc Settings_RestoreDefaults}" Click="OnRestoreDefaults" />
            <Button DockPanel.Dock="Right" Content="{res:Loc Settings_Cancel}" IsCancel="True" />
            <Button DockPanel.Dock="Right" Content="{res:Loc Settings_Save}" IsDefault="True" Click="OnSave" />
        </DockPanel>
    </StackPanel>
</Window>
