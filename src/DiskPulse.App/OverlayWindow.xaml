<Window x:Class="DiskPulse.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DiskPulse.App"
        Title="DiskPulse"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI"
        FontSize="12"
        MouseLeftButtonDown="OnMouseLeftButtonDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:FontScaleConverter x:Key="FontScale" />
    </Window.Resources>

    <Border Background="#D91A1A1A"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            CornerRadius="6"
            Padding="10,6">
        <StackPanel>
            <TextBlock Text="{Binding Message}"
                       Foreground="{Binding MessageBrush}"
                       TextWrapping="Wrap"
                       MaxWidth="420"
                       Margin="0,2"
                       Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}" />

            <ItemsControl ItemsSource="{Binding Disks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Transparent background so the whole row, not just the text, shows the tooltip. -->
                        <Grid Margin="0,3" Background="Transparent" ToolTipService.ShowDuration="60000">
                            <Grid.ToolTip>
                                <ToolTip>
                                    <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" MaxWidth="360" />
                                </ToolTip>
                            </Grid.ToolTip>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Sized from the font so the dot scales with the font-size setting. -->
                            <Ellipse Width="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontScale}, ConverterParameter=0.8}"
                                     Height="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontScale}, ConverterParameter=0.8}"
                                     Margin="0,4,8,0"
                                     VerticalAlignment="Top"
                                     Fill="{Binding StatusBrush}" />

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Label}" Foreground="#FFEEEEEE" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Metrics}"
                                           Foreground="#FFBBBBBB"
                                           FontFamily="Consolas"
                                           Visibility="{Binding HasMetrics, Converter={StaticResource BoolToVisibility}}" />
                                <StackPanel Margin="0,3,0,1" Visibility="{Binding HasSparkline, Converter={StaticResource BoolToVisibility}}">
                                    <local:Sparkline Data="{Binding Sparkline}"
                                                     Stroke="{Binding StatusBrush}"
                                                     HorizontalAlignment="Left"
                                                     Width="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontScale}, ConverterParameter=20}"
                                                     Height="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontScale}, ConverterParameter=2.5}" />
                                    <TextBlock Text="{Binding SparklineCaption}"
                                               Foreground="#FF999999"
                                               FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontScale}, ConverterParameter=0.85}" />
                                </StackPanel>
                                <TextBlock Text="{Binding StatusText}"
                                           Foreground="{Binding StatusBrush}"
                                           FontWeight="SemiBold"
                                           Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
